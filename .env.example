# ─────────────────────────────────────────────────────────────────
# Mẫu biến môi trường cho kết nối DB.
# Copy thành .env (cùng thư mục này) rồi điền giá trị thật.
# NHỚ thêm `.env` vào .gitignore - file này chứa mật khẩu.
# ─────────────────────────────────────────────────────────────────

# ── BẮT BUỘC ──────────────────────────────────────────────────────
# Máy chủ DB (IP hoặc hostname). KHÔNG phải URL web app.
DB_HOST=
# Tên database / schema
DB_NAME=
# Tài khoản DB - nên xin user CHỈ CÓ QUYỀN SELECT để test
DB_USER=
DB_PASSWORD=

# ── TUỲ CHỌN ──────────────────────────────────────────────────────
# mysql (mặc định) | pg
DB_CLIENT=mysql
# MySQL 3306 | PostgreSQL 5432
DB_PORT=3306

# Bật TLS khi DB nằm ngoài mạng nội bộ
DB_SSL=false
# false = chấp nhận chứng chỉ tự ký (chỉ dùng cho môi trường test)
DB_SSL_STRICT=true

# Số kết nối tối đa - để >= số worker Playwright
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=10000
DB_QUERY_TIMEOUT=15000

# true = chặn mọi INSERT/UPDATE/DELETE. Mặc định true.
# Chỉ đặt false khi chắc chắn đang trỏ vào DB test riêng.
DB_READONLY=true
